# This token is provisioned for one control-plane exit node. Keep this file
# service-owned and do not commit a real token.
TONO_HOME_AGENT_TOKEN=replace-with-node-token

TONO_API_BASE=https://api.example.com

# Must exactly match the control-plane exit node ID paired with the token above.
# Usage reports send this value as sourceId.
TONO_SOURCE_ID=replace-with-durable-state-source-id

TONO_XRAY_BINARY=/opt/tono-xray/current/xray
TONO_XRAY_API_ADDRESS=127.0.0.1:10085
TONO_XRAY_INBOUND_TAG=tono-vless
TONO_AGENT_STATE=/var/lib/tono-exit-agent/state.json

# Optional rollback override. Unset to follow retireSharedLegacy from the server.
# TONO_RETIRE_SHARED_LEGACY=false
