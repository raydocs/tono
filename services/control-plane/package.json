{
  "name": "tono-control-plane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:dev": "vite admin --base /ops/",
    "admin:build": "vite build admin --base /ops/ --outDir ../public/ops --emptyOutDir",
    "admin:worker:deploy": "npm run deploy",
    "preview:render-config": "node preview/render-config.mjs",
    "preview:seed": "node preview/write-seed.mjs",
    "predev": "npm run admin:build",
    "dev": "wrangler dev",
    "deploy": "../../tooling/scripts/deploy-control-plane-main.sh",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260907.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "4.1.11",
    "wrangler": "^4.129.0"
  }
}
