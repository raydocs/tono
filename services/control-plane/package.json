{
  "name": "tono-control-plane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:dev": "vite admin --base /ops/",
    "admin:build": "vite build admin --base /ops/ --outDir ../public/ops --emptyOutDir",
    "console:build": "npm --prefix ../ops-console ci && npm --prefix ../ops-console run build",
    "admin:worker:deploy": "npm run deploy",
    "preview:render-config": "node preview/render-config.mjs",
    "preview:seed": "node preview/write-seed.mjs",
    "predev": "npm run admin:build",
    "dev": "wrangler dev",
    "deploy": "../../tooling/scripts/deploy-control-plane-main.sh",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "vitest run",
    "check:contract": "node ../../tooling/scripts/check-ops-contract-purity.mjs",
    "check:budgets": "node ../../tooling/scripts/check-ops-budgets.mjs"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.22.0",
    "@cloudflare/workers-types": "^5.20260917.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "jsdom": "^30.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.1",
    "wrangler": "^4.134.0"
  },
  "overrides": {
    "sharp": "0.35.4"
  }
}
