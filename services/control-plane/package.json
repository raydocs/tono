{
  "name": "tono-control-plane",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:dev": "vite admin --base /ops/",
    "admin:build": "vite build admin --base /ops/ --outDir ../public/ops --emptyOutDir",
    "admin:worker:deploy": "npm run admin:build && wrangler deploy --config wrangler.admin.jsonc",
    "predev": "npm run admin:build",
    "dev": "wrangler dev",
    "deploy": "../../tooling/scripts/deploy-control-plane-main.sh",
    "typecheck": "tsc --noEmit && tsc -p admin/tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "^5.20260728.1",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "^5.9.2",
    "vite": "^8.0.14",
    "vitest": "4.1.10",
    "wrangler": "^4.26.1"
  }
}
