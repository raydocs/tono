{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tono-control-plane-staging",
  "main": "src/index.ts",
  "compatibility_date": "2025-09-02",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "api.afk.ccwu.cc",
      "custom_domain": true
    },
    {
      "pattern": "releases.afk.ccwu.cc",
      "custom_domain": true
    }
  ],
  "triggers": { "crons": ["*/5 * * * *"] },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "secrets": {
    "required": [
      "JWT_SECRET",
      "ADMIN_API_TOKEN",
      "HOME_AGENT_TOKEN",
      "TAILSCALE_OAUTH_CLIENT_ID",
      "TAILSCALE_OAUTH_CLIENT_SECRET",
      "RESEND_API_KEY",
      "CATALOG_ENCRYPTION_KEY",
      "ACCESS_TEAM_DOMAIN",
      "ACCESS_AUD",
      "ACCESS_ADMIN_EMAILS"
    ]
    // Optional: OPS_COLLECTOR_TOKEN — VPS collector PUT /api/v1/ops-ingest/snapshot.
    // Unset keeps /ops/live on the legacy ops/quality host fetch.
  },
  "d1_databases": [{
    "binding": "DB", "database_name": "tono-control-plane",
    "database_id": "caf9b9fb-b4d5-498d-a1ad-7d5cdbb4237c", "migrations_dir": "migrations"
  }],
  // Raw audit-log segments uploaded by running clients. Megabytes per hour per
  // device, so they cannot live in D1 (the whole database is single-digit MB);
  // D1 keeps only the index in `diagnostics_log_objects`. Objects are deleted by
  // the scheduled cleanup at the same retention as their index rows.
  "r2_buckets": [{
    "binding": "DIAGNOSTICS_LOGS", "bucket_name": "tono-diagnostics-logs"
  }, {
    // Installers are served from here rather than from the GitHub release, so a
    // download does not depend on the repository being public and does not cross
    // to a host that mainland China filters.
    "binding": "RELEASES", "bucket_name": "tono-releases"
  }],
  "vars": {
    "ALLOWED_ORIGIN": "https://api.afk.ccwu.cc",
    // Public half of the traffic-policy signing key. A var, not a secret: it is
    // public by construction, and keeping it in the repository is what lets
    // anyone check which key this deployment trusts against what the clients
    // were built with. The private half exists only in the operator's keychain
    // (`security find-generic-password -s tono-policy-signing`) and is never
    // held by this Worker — if it were, taking the Worker would be enough to
    // mint a policy that pulls arbitrary hosts out of the tunnel.
    //
    // Changing this value invalidates the signature on the live policy. Publish
    // a policy signed by the new key in the same change, or clients will reject
    // the document and fall back to their compiled-in allowlists.
    "TRAFFIC_POLICY_PUBLIC_KEY": "Sf2burVHXZWzYikU0FlC+N64BeRZJxJe8XaneblmTkM=",
    "TAILSCALE_TAILNET": "Tcw8bpg2c621CNTRL",
    "TAILSCALE_ENROLLMENT_ENABLED": "false",
    "ACCESS_TOKEN_TTL_SECONDS": "86400",
    "REFRESH_TOKEN_TTL_SECONDS": "2592000",
    "PENDING_DEVICE_TTL_SECONDS": "1800",
    "RATE_LIMIT_WINDOW_SECONDS": "900",
    "RATE_LIMIT_EMAIL_START_IP": "20",
    "RATE_LIMIT_EMAIL_START_EMAIL": "5",
    "RATE_LIMIT_EMAIL_VERIFY_IP": "30",
    "RATE_LIMIT_EMAIL_VERIFY_CHALLENGE": "5",
    "RATE_LIMIT_OIDC_START_IP": "20",
    "RATE_LIMIT_OIDC_START_INSTALLATION": "10",
    "RATE_LIMIT_OIDC_VERIFY_IP": "30",
    "RATE_LIMIT_OIDC_VERIFY_CHALLENGE": "5",
    "RATE_LIMIT_DIAGNOSTICS_IP_HOUR": "30",
    "RATE_LIMIT_DIAGNOSTICS_USER_HOUR": "5",
    "RATE_LIMIT_DIAGNOSTICS_USER_DAY": "20",
    "DIAGNOSTICS_RETENTION_SECONDS": "2592000",
    // Raw logs are far larger than reports and are re-uploaded continuously, so
    // they expire much sooner: 14 days is longer than any triage cycle so far.
    "DIAGNOSTICS_LOG_RETENTION_SECONDS": "1209600",
    // One segment per minute per device, with a daily backstop. A client that
    // loses its cursor and replays cannot spend more than a day's budget.
    "RATE_LIMIT_DIAGNOSTICS_LOG_USER_HOUR": "80",
    "RATE_LIMIT_DIAGNOSTICS_LOG_USER_DAY": "800",
    "RATE_LIMIT_ROUTING_RESEARCH_DEVICE_REQUEST_DAY": "100",
    "RATE_LIMIT_ROUTING_RESEARCH_DEVICE_DAY": "4",
    "ROUTING_RESEARCH_RETENTION_SECONDS": "7776000",
    "EMAIL_CODE_TTL_SECONDS": "600",
    "OIDC_CHALLENGE_TTL_SECONDS": "300",
    "EMAIL_FROM": "Tono <login@lecvia.com>",
    "APPLE_CLIENT_ID": "com.raydocs.tono",
    "GOOGLE_CLIENT_ID": "",
    "DIRECT_SIGNUP_ALLOWLIST": "ruiruiwan2019@gmail.com,ruiruiwan8@gmail.com,stephonhe0227@gmail.com",
    "CONFIRM_CLAIM_TTL_SECONDS": "300"
  }
}
