[Unit]
Description=Tono node agent heartbeat (A20)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/tono/node-agent.env
# The token file stays root-only (0600); systemd hands this unit a private copy.
LoadCredential=node-agent-token:/etc/tono/node-agent.token
ExecStart=/usr/bin/python3 -I /opt/tono-node-agent/tono_node_agent.py
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
TimeoutStartSec=60
