{
  "name": "tono-ops-console",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "vite build --base /ops2/ --outDir ../control-plane/public/ops2 --emptyOutDir && node scripts/check-budgets.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:locked": "../../tooling/scripts/with-slot.sh playwright 1 -- npx playwright test --workers=2",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.2.6",
    "framer-motion": "^13.2.0",
    "geist": "^1.5.1",
    "lucide-react": "^1.44.0",
    "motion": "^13.2.0",
    "radix-ui": "^1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.1.13",
    "@types/node": "^26.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.6",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.1.13",
    "tw-animate-css": "^1.3.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.44.0",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  }
}
