{
  "name": "tono-ops-console",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:fixtures": "vite --mode fixtures",
    "build": "vite build --base /ops/ --outDir ../control-plane/public/ops --emptyOutDir && node scripts/remove-retired-console.mjs && node scripts/check-budgets.mjs",
    "typecheck": "tsc --noEmit && node ../unchecked-index-ratchet.mjs --baseline unchecked-index.baseline -- ./node_modules/.bin/tsc --noEmit --pretty false --incremental false --noUncheckedIndexedAccess",
    "test": "vitest run",
    "lint": "eslint src --max-warnings=0",
    "budgets": "node scripts/check-budgets.mjs",
    "test:e2e": "playwright test",
    "test:e2e:locked": "../../tooling/scripts/with-slot.sh playwright 1 -- npx playwright test --workers=2",
    "test:e2e:update": "playwright test --update-snapshots",
    "proto": "vite -c vite.prototype.config.ts",
    "proto:build": "vite build -c vite.prototype.config.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "framer-motion": "^14.0.0",
    "geist": "^1.7.2",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "radix-ui": "^1.7.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "js-yaml": "^5.4.3",
    "jsdom": "^30.1.2",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "5.0.3"
  }
}
