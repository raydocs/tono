# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
**/*.xcodeproj/xcuserdata/
*.xcworkspace/xcshareddata/swiftpm/
**/*.xcworkspace/xcshareddata/swiftpm/*
!**/*.xcworkspace/xcshareddata/swiftpm/Package.resolved

# macOS
.DS_Store
*.swp
*~

# Legacy local paths (never tracked)
LiquidClash/design/

# Claude / AI tooling
# Not `.claude/`: an ignored *directory* is never descended into, so a
# negation inside it can never take effect. Ignore the contents instead,
# then re-include skills — they are shared project knowledge and belong in
# review, unlike settings.local.json which is per-machine.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
# Per-session agent state (AGENTS.md "Session state"); never committed.
/SESSION_STATE.md
.codex/
.serena/
.spec-workflow/

# Pre-existing local Windows notes (not part of the tracked source tree)
/apps/windows/docs/
/apps/windows/app/docs/

# Local dev scripts
script/

LiquidClashHelper/

# Rust build artifacts
**/target/
.rust-build/

# Python
__pycache__/
tooling/perf/connect-bench/.cache/
tooling/perf/connect-bench/last-run.json

# Wrangler local cache
.wrangler/

# Accidental working-tree fetch marker (real FETCH_HEAD lives in .git/)
FETCH_HEAD

# Packaged macOS build output (gitignored; do not re-add)
artifacts/

# Node — the workspaces keep their own; a stray root one is a tool artefact
# Also ignore local dependency-cache symlinks used by isolated worktrees.
node_modules

# Istanbul output from the control-plane coverage floor. The numbers are enforced
# by vitest thresholds; the directory is a local report.
services/control-plane/coverage/

# Local development environments
.venv/

# Amp orb runtime
.amp/portals/*
