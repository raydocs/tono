# Xcode
build/
DerivedData/
*.xcuserstate
*.xcworkspace/xcuserdata/
*.xcodeproj/xcuserdata/
**/*.xcodeproj/xcuserdata/
*.xcworkspace/xcshareddata/swiftpm/
**/*.xcworkspace/xcshareddata/swiftpm/*
!**/*.xcworkspace/xcshareddata/swiftpm/Package.resolved

# macOS
.DS_Store
*.swp
*~

# Design mockups (temporary)
LiquidClash/design/

# Claude / AI tooling
# Not `.claude/`: an ignored *directory* is never descended into, so a
# negation inside it can never take effect. Ignore the contents instead,
# then re-include skills — they are shared project knowledge and belong in
# review, unlike settings.local.json which is per-machine.
.claude/*
!.claude/skills/
.codex/
.serena/
.spec-workflow/

# Pre-existing local Windows notes (not part of the tracked source tree)
/apps/windows/docs/
/apps/windows/app/docs/

# Local dev scripts
script/

# Helper source (compiled binary in Resources)
LiquidClashHelper/

# Rust build artifacts
**/target/
.rust-build/

# Python
__pycache__/

# Wrangler local cache
.wrangler/

# Packaged macOS build output (1.1 GB of .app bundles as of build 47)
artifacts/

# Node — the workspaces keep their own; a stray root one is a tool artefact
node_modules/

# Local development environments
.venv/

# Amp orb runtime
.amp/portals/*
