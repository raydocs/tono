#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

run_step() {
  local label="$1"
  shift
  local started=$SECONDS

  printf '\n==> %s\n' "$label"
  "$@"
  printf '<== %s (%ss)\n' "$label" "$((SECONDS - started))"
}

install_system_packages() {
  local packages=(
    build-essential
    libayatana-appindicator3-dev
    librsvg2-dev
    libssl-dev
    libwebkit2gtk-4.1-dev
    libxslt1.1
    patchelf
    pkg-config
    python3-venv
    xz-utils
  )
  local missing=()
  local package

  for package in "${packages[@]}"; do
    if ! dpkg-query -W -f='${Status}' "$package" 2>/dev/null | grep -Fq 'install ok installed'; then
      missing+=("$package")
    fi
  done

  if ((${#missing[@]} == 0)); then
    echo 'All system packages are already installed.'
    return
  fi

  echo "Installing missing system packages: ${missing[*]}"
  if ((EUID == 0)); then
    apt-get update
    env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
  else
    sudo apt-get update
    sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
  fi
}

install_node() {
  local version='v24.18.0'
  local archive="node-${version}-linux-x64.tar.xz"
  local install_root="$HOME/.local/share/tono"
  local version_root="$install_root/node-${version}"
  local active_root="$HOME/.local/tono-node"
  local download_dir

  mkdir -p "$install_root"
  if [[ ! -x "$version_root/bin/node" ]] || [[ "$($version_root/bin/node --version)" != "$version" ]]; then
    download_dir="$(mktemp -d)"
    curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/${version}/${archive}" \
      --output "$download_dir/$archive"
    curl --fail --silent --show-error --location \
      "https://nodejs.org/dist/${version}/SHASUMS256.txt" \
      --output "$download_dir/SHASUMS256.txt"
    grep -F "  $archive" "$download_dir/SHASUMS256.txt" > "$download_dir/$archive.sha256"
    (cd "$download_dir" && sha256sum --check "$archive.sha256")

    rm -rf "$version_root.tmp"
    mkdir -p "$version_root.tmp"
    tar -xJf "$download_dir/$archive" -C "$version_root.tmp" --strip-components=1
    rm -rf "$version_root"
    mv "$version_root.tmp" "$version_root"
    rm -rf "$download_dir"
  fi

  ln -sfn "$version_root" "$active_root"
  export PATH="$active_root/bin:$PATH"

  corepack enable pnpm
  corepack prepare pnpm@11.3.0 --activate
  corepack prepare pnpm@10.18.1

  node --version
  npm --version
  (cd apps/windows/app && pnpm --version)
  (cd apps/windows/crates/tono-plugin-core && pnpm --version)
}

persist_toolchain_path() {
  local profile="$HOME/.bash_profile"
  local marker='# Tono orb toolchains'

  touch "$profile"
  if grep -Fqx "$marker" "$profile"; then
    echo 'Login-shell toolchain path is already configured.'
    return
  fi

  cat >> "$profile" <<'EOF'

# Tono orb toolchains
export PATH="$HOME/.local/tono-node/bin:$HOME/.cargo/bin:$PATH"
EOF
}

install_rust() {
  export PATH="$HOME/.cargo/bin:$PATH"

  if ! command -v rustup >/dev/null 2>&1; then
    local installer
    installer="$(mktemp)"
    curl --proto '=https' --tlsv1.2 --fail --silent --show-error \
      https://sh.rustup.rs --output "$installer"
    sh "$installer" -y --profile minimal --default-toolchain none
    rm -f "$installer"
  fi

  if ! rustup run 1.95.0 rustc --version >/dev/null 2>&1; then
    rustup toolchain install 1.95.0 --profile minimal --component rustfmt --component clippy
  fi
  if ! rustup component list --toolchain 1.95.0 --installed | grep -q '^rustfmt-'; then
    rustup component add --toolchain 1.95.0 rustfmt
  fi
  if ! rustup component list --toolchain 1.95.0 --installed | grep -q '^clippy-'; then
    rustup component add --toolchain 1.95.0 clippy
  fi
  if [[ "$(rustup default | awk '{print $1}')" != 1.95.0-* ]]; then
    rustup default 1.95.0
  fi

  rustc --version
  cargo --version
}

install_node_dependencies() {
  npm --prefix services/control-plane ci --no-audit --no-fund
  (cd apps/windows/app && pnpm install --frozen-lockfile)
  (cd apps/windows/crates/tono-plugin-core && pnpm install --frozen-lockfile)
}

install_python_dependencies() {
  if [[ ! -x .venv/bin/python ]]; then
    python3 -m venv .venv
  fi
  .venv/bin/python -m pip install \
    --disable-pip-version-check \
    --no-input \
    --requirement design-assets/tono-icon/requirements.txt
}

fetch_rust_dependencies() {
  local manifests=(
    apps/windows/Cargo.toml
    apps/windows/app/Cargo.toml
    apps/windows/service/Cargo.toml
    apps/windows/vendor/kode-bridge/Cargo.toml
    apps/macos/Tono/Tools/Cargo.toml
  )
  local manifest

  for manifest in "${manifests[@]}"; do
    echo "Fetching dependencies for $manifest"
    cargo fetch --locked --manifest-path "$manifest"
  done
}

prepare_local_environment() {
  if [[ ! -f services/control-plane/.dev.vars ]]; then
    cp -- services/control-plane/.dev.vars.example services/control-plane/.dev.vars
    echo 'Created services/control-plane/.dev.vars from its development template.'
  else
    echo 'Preserved existing services/control-plane/.dev.vars.'
  fi
}

run_step 'Install system build packages' install_system_packages
run_step 'Install the pinned Node.js and pnpm toolchains' install_node
run_step 'Persist toolchains for future login shells' persist_toolchain_path
run_step 'Install the pinned Rust toolchain' install_rust
run_step 'Install locked Node.js dependencies' install_node_dependencies
run_step 'Install pinned Python design dependencies' install_python_dependencies
run_step 'Cache locked Rust dependencies' fetch_rust_dependencies
run_step 'Prepare the local development environment' prepare_local_environment

printf '\nTono orb setup complete in %ss.\n' "$SECONDS"
