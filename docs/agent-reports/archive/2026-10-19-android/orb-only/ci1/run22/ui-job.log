2026-10-18T07:50:34.5686131Z ##[group]Run cat > evidence.sh <<'SH'
2026-10-18T07:50:34.5687020Z cat > evidence.sh <<'SH'
2026-10-18T07:50:34.5687742Z set -euxo pipefail
2026-10-18T07:50:34.5688228Z APP=com.raydocs.tono.mobile.test
2026-10-18T07:50:34.5688903Z # A retry keeps the first attempt's evidence next to the second's.
2026-10-18T07:50:34.5689783Z if [ -d evidence ]; then mv evidence "evidence-attempt-$(date +%s)"; fi
2026-10-18T07:50:34.5690448Z mkdir -p evidence
2026-10-18T07:50:34.5691055Z adb shell getprop ro.build.fingerprint | tee evidence/device.txt
2026-10-18T07:50:34.5691895Z adb shell getprop ro.product.cpu.abi | tee -a evidence/device.txt
2026-10-18T07:50:34.5692681Z adb shell wm size | tee -a evidence/device.txt
2026-10-18T07:50:34.5693359Z adb shell wm density | tee -a evidence/device.txt
2026-10-18T07:50:34.5694055Z adb shell settings put system screen_off_timeout 1800000
2026-10-18T07:50:34.5694660Z adb shell svc power stayon true
2026-10-18T07:50:34.5695183Z adb shell input keyevent 82 || true
2026-10-18T07:50:34.5695989Z # Let the launcher finish its first-boot work; on swiftshader it can otherwise raise an ANR
2026-10-18T07:50:34.5696825Z # dialog over the app. The test answers only foreign ANR dialogs and logs each one.
2026-10-18T07:50:34.5697844Z sleep 60
2026-10-18T07:50:34.5698143Z adb shell input keyevent 3
2026-10-18T07:50:34.5698562Z # No -g: runtime permissions and VPN consent stay as on a fresh install.
2026-10-18T07:50:34.5698993Z adb install -r apk/*-test-*.apk
2026-10-18T07:50:34.5699324Z adb install -r apk/instrumentation.apk
2026-10-18T07:50:34.5699816Z # One instrumentation call per test, pulling evidence after each, so an emulator crash
2026-10-18T07:50:34.5700418Z # (seen on hosted runners) costs one test's evidence rather than all of it.
2026-10-18T07:50:34.5700824Z set +e
2026-10-18T07:50:34.5701033Z failed=""
2026-10-18T07:50:34.5701442Z # Streamed from the host, so an emulator that dies mid-run still leaves its last log lines.
2026-10-18T07:50:34.5701997Z adb logcat -v threadtime > evidence/logcat-live.txt 2>&1 &
2026-10-18T07:50:34.5702369Z logcat=$!
2026-10-18T07:50:34.5702597Z case "$SHARD" in
2026-10-18T07:50:34.5703179Z   system) tests="DeviceEvidenceTest#a1_realSignInScreenAndLocalValidation DeviceEvidenceTest#a2_realSystemVpnConsentDialog
2026-10-18T07:50:34.5704282Z   DeviceEvidenceTest#a3_realEngineRefusesToConnectWithoutAccount DeviceEvidenceTest#a4_realCoreOnThisAbiAcceptsTheGeneratedConfig
2026-10-18T07:50:34.5705284Z   DeviceEvidenceTest#a5_realAppHonoursRemoveAnimations DeviceEvidenceTest#a6_realAppUnderSystemLightAndDarkTheme
2026-10-18T07:50:34.5706084Z   SystemSurfacesDeviceTest#s1_realQuickSettingsTileShowsSharedStatusAndOpensTheApp
2026-10-18T07:50:34.5706908Z   SystemSurfacesDeviceTest#s2_realWidgetInAndroidsWidgetHost SystemSurfacesDeviceTest#s3_fixtureWidgetAndNotificationStates
2026-10-18T07:50:34.5708134Z   DeviceEvidenceTest#b1_fixtureStatesRenderedOnDevice DeviceEvidenceTest#b2_fixtureMotionRecordedOnDevice
2026-10-18T07:50:34.5708765Z   DeviceEvidenceTest#b3_fixtureAtLargeFontScale" ;;
2026-10-18T07:50:34.5709490Z   ui) tests="HorizonUiDeviceTest#u1_accessibilityContractAndAtfOnEveryScreen HorizonUiDeviceTest#u2_primaryControlActsThroughRealTaps
2026-10-18T07:50:34.5710403Z   HorizonUiDeviceTest#u3_swipeUpOnTheDockOpensDetails HorizonUiDeviceTest#u4_glassBlursTheSceneBehindIt
2026-10-18T07:50:34.5711269Z   HorizonUiDeviceTest#u5_consentExplainedBeforeTheSystemDialog HorizonUiDeviceTest#u6_screenReaderOrderAndLabelsOnHome
2026-10-18T07:50:34.5712357Z   HorizonUiDeviceTest#u7_simplifiedChineseCopyFitsEveryScreen HorizonUiDeviceTest#u8_motionFrameByFrameAt60fps
2026-10-18T07:50:34.5713043Z   LargeTextDeviceTest#l1_largestSystemTextIsNeverCutOff" ;;
2026-10-18T07:50:34.5713466Z   *) echo "unknown shard $SHARD"; exit 1 ;;
2026-10-18T07:50:34.5713769Z esac
2026-10-18T07:50:34.5714022Z echo "shard $SHARD" > evidence/shard.txt
2026-10-18T07:50:34.5714338Z for c in $tests; do
2026-10-18T07:50:34.5714599Z   t="${c#*#}"
2026-10-18T07:50:34.5714829Z   rec=""
2026-10-18T07:50:34.5715113Z   if [ "$t" = b2_fixtureMotionRecordedOnDevice ]; then
2026-10-18T07:50:34.5715618Z     # Recorded from the host: a screenrecord started inside the test kept the run open.
2026-10-18T07:50:34.5716303Z     adb shell screenrecord --time-limit 25 --bit-rate 8000000 /sdcard/Download/tono-fixture-motion.mp4 &
2026-10-18T07:50:34.5716806Z     rec=$!
2026-10-18T07:50:34.5717034Z   fi
2026-10-18T07:50:34.5717743Z   timeout 900 adb shell am instrument -w -r -e class "com.raydocs.tono.mobile.$c" \
2026-10-18T07:50:34.5718374Z     $APP.test/androidx.test.runner.AndroidJUnitRunner > "evidence/instrument-$t.txt"
2026-10-18T07:50:34.5718910Z   [ -n "$rec" ] && timeout 60 tail --pid="$rec" -f /dev/null
2026-10-18T07:50:34.5719623Z   grep -q '^OK (' "evidence/instrument-$t.txt" && echo "PASS $t" >> evidence/summary.txt || { echo "FAIL $t" >> evidence/summary.txt; failed="$failed $t"; }
2026-10-18T07:50:34.5720513Z   timeout 120 adb pull /sdcard/Android/data/$APP/files/evidence/. evidence/
2026-10-18T07:50:34.5721283Z   [ "$t" = b2_fixtureMotionRecordedOnDevice ] && timeout 120 adb pull /sdcard/Download/tono-fixture-motion.mp4 evidence/fixture-motion.mp4
2026-10-18T07:50:34.5722075Z   # A dead emulator fails every later test with no output; say so once and stop, so the
2026-10-18T07:50:34.5722701Z   # fresh-emulator retry starts sooner. Every test must still pass in a single session.
2026-10-18T07:50:34.5723253Z   if [ "$(timeout 30 adb get-state 2>/dev/null)" != device ]; then
2026-10-18T07:50:34.5723818Z     echo "DEVICE-OFFLINE after $t; later tests not run in this attempt" >> evidence/summary.txt
2026-10-18T07:50:34.5724316Z     failed="$failed device-offline"
2026-10-18T07:50:34.5724612Z     break
2026-10-18T07:50:34.5724836Z   fi
2026-10-18T07:50:34.5725165Z   # Isolation: a shade a test left open would cover the next test's app.
2026-10-18T07:50:34.5725613Z   timeout 30 adb shell cmd statusbar collapse
2026-10-18T07:50:34.5725932Z done
2026-10-18T07:50:34.5726140Z kill $logcat
2026-10-18T07:50:34.5726528Z # Leave the shared emulator settings as found, whatever a failed test left behind.
2026-10-18T07:50:34.5727013Z adb shell settings put system font_scale 1.0
2026-10-18T07:50:34.5727717Z adb shell settings put global animator_duration_scale 1
2026-10-18T07:50:34.5728096Z adb shell cmd uimode night no
2026-10-18T07:50:34.5728433Z timeout 60 adb logcat -d > evidence/logcat.txt
2026-10-18T07:50:34.5728759Z ls -la evidence
2026-10-18T07:50:34.5729016Z cat evidence/summary.txt
2026-10-18T07:50:34.5729275Z set -e
2026-10-18T07:50:34.5729507Z [ -z "$failed" ]
2026-10-18T07:50:34.5729738Z SH
2026-10-18T07:50:34.5794148Z shell: /usr/bin/bash -e {0}
2026-10-18T07:50:34.5794507Z ##[endgroup]
