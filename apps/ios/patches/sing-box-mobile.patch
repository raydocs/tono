diff --git a/experimental/libbox/tono_packet_flow.go b/experimental/libbox/tono_packet_flow.go
new file mode 100644
index 000000000..826007798
--- /dev/null
+++ b/experimental/libbox/tono_packet_flow.go
@@ -0,0 +1,177 @@
+//go:build tono_mobile && with_gvisor
+
+package libbox
+
+import (
+	"context"
+	"crypto/tls"
+	"encoding/binary"
+	"errors"
+	"io"
+	"sync"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/buffer"
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+	"github.com/sagernet/gvisor/pkg/tcpip/link/channel"
+	"github.com/sagernet/gvisor/pkg/tcpip/stack"
+	box "github.com/sagernet/sing-box"
+	"github.com/sagernet/sing-box/adapter"
+	"github.com/sagernet/sing-box/option"
+	tun "github.com/sagernet/sing-tun"
+	"github.com/sagernet/sing/common/logger"
+	M "github.com/sagernet/sing/common/metadata"
+	"github.com/sagernet/sing/service"
+)
+
+// TonoPacketSession transports raw IP packets, without the Darwin four-byte
+// utun header. The caller installs NE settings BEFORE starting the session.
+// Read blocks on a bounded queue; Close wakes it. No FD, listener or KVC API.
+type TonoPacketSession struct {
+	flow *tonoFlow
+	box  *box.Box
+	once sync.Once
+}
+
+func TonoStart(configuration string) (*TonoPacketSession, error) {
+	ctx, cancel := context.WithCancel(baseContext(nil))
+	f := &tonoFlow{endpoint: channel.New(128, 1280, ""), ctx: ctx, cancel: cancel}
+	p := &tonoPlatform{flow: f}
+	ctx = service.ContextWith[adapter.PlatformInterface](ctx, p)
+	opts, err := parseConfig(ctx, configuration)
+	if err != nil {
+		f.Close()
+		return nil, errors.New("TONO_CONFIG_INVALID")
+	}
+	b, err := box.New(box.Options{Context: ctx, Options: opts})
+	if err != nil {
+		f.Close()
+		return nil, errors.New("TONO_CORE_CREATE_FAILED")
+	}
+	if err = b.Start(); err != nil {
+		f.Close()
+		b.Close()
+		return nil, errors.New("TONO_CORE_START_FAILED")
+	}
+	return &TonoPacketSession{flow: f, box: b}, nil
+}
+
+func (s *TonoPacketSession) Write(packet []byte) error { return s.flow.inject(packet) }
+func (s *TonoPacketSession) Read() ([]byte, error) {
+	p := s.flow.endpoint.ReadContext(s.flow.ctx)
+	if p == nil {
+		return nil, io.EOF
+	}
+	defer p.DecRef()
+	v := p.ToView()
+	defer v.Release()
+	return append([]byte(nil), v.AsSlice()...), nil
+}
+func (s *TonoPacketSession) Close() {
+	s.once.Do(func() { s.flow.Close(); s.box.Close() })
+}
+
+// Probe the selected proxy, never a provider URLSession that escapes the tunnel.
+func (s *TonoPacketSession) Probe() error {
+	ctx, cancel := context.WithTimeout(s.flow.ctx, 10*time.Second)
+	defer cancel()
+	outbound, ok := s.box.Outbound().Outbound("Tono-Exit")
+	if !ok {
+		return errors.New("TONO_PROBE_FAILED")
+	}
+	conn, err := outbound.DialContext(ctx, "tcp", M.ParseSocksaddr("1.1.1.1:443"))
+	if err != nil {
+		return errors.New("TONO_PROBE_FAILED")
+	}
+	defer conn.Close()
+	client := tls.Client(conn, &tls.Config{ServerName: "1.1.1.1", MinVersion: tls.VersionTLS12})
+	if client.HandshakeContext(ctx) != nil {
+		return errors.New("TONO_PROBE_FAILED")
+	}
+	return nil
+}
+
+type tonoPlatform struct {
+	platformInterfaceStub
+	flow *tonoFlow
+}
+
+func (p *tonoPlatform) UsePlatformInterface() bool               { return true }
+func (p *tonoPlatform) UnderNetworkExtension() bool              { return true }
+func (p *tonoPlatform) NetworkExtensionIncludeAllNetworks() bool { return true }
+
+// Network Extension provider-created sockets are outside its own packet flow.
+// NE controls routing; never ask sing-tun to create or discover a utun device.
+func (p *tonoPlatform) OpenInterface(o *tun.Options, _ option.TunPlatformOptions) (tun.Tun, error) {
+	if o.MTU != 1280 {
+		return nil, errors.New("TONO_MTU_INVALID")
+	}
+	return p.flow, nil
+}
+func (p *tonoPlatform) CreateDefaultInterfaceMonitor(logger.Logger) tun.DefaultInterfaceMonitor {
+	return &tonoMonitor{}
+}
+
+type tonoMonitor struct{ interfaceMonitorStub }
+
+func (*tonoMonitor) Start() error { return nil }
+func (*tonoMonitor) Close() error { return nil }
+
+type tonoFlow struct {
+	endpoint *channel.Endpoint
+	ctx      context.Context
+	cancel   context.CancelFunc
+	once     sync.Once
+}
+
+var _ tun.GVisorTun = (*tonoFlow)(nil)
+
+func (f *tonoFlow) Name() (string, error)                          { return "Tono-PacketFlow", nil }
+func (f *tonoFlow) Start() error                                   { return nil }
+func (f *tonoFlow) Close() error                                   { f.once.Do(func() { f.cancel(); f.endpoint.Close() }); return nil }
+func (f *tonoFlow) UpdateRouteOptions(tun.Options) error           { return errors.New("TONO_RESTART_REQUIRED") }
+func (f *tonoFlow) Read([]byte) (int, error)                       { return 0, errors.New("TONO_RAW_IO_UNSUPPORTED") }
+func (f *tonoFlow) Write([]byte) (int, error)                      { return 0, errors.New("TONO_RAW_IO_UNSUPPORTED") }
+func (f *tonoFlow) NewStack(o tun.StackOptions) (tun.Stack, error) { return tun.NewGVisor(o) }
+func (f *tonoFlow) NewEndpoint() (stack.LinkEndpoint, stack.NICOptions, error) {
+	return f.endpoint, stack.NICOptions{}, nil
+}
+func (f *tonoFlow) WritePacket(p *stack.PacketBuffer) (int, error) {
+	var packets stack.PacketBufferList
+	packets.PushBack(p)
+	n, err := f.endpoint.WritePackets(packets)
+	if err != nil || n != 1 {
+		return 0, errors.New("TONO_PACKET_QUEUE_FULL")
+	}
+	return p.Size(), nil
+}
+func (f *tonoFlow) inject(b []byte) error {
+	select {
+	case <-f.ctx.Done():
+		return io.EOF
+	default:
+	}
+	if len(b) < 20 || len(b) > 1280 {
+		return errors.New("TONO_PACKET_INVALID")
+	}
+	var protocol tcpip.NetworkProtocolNumber
+	switch b[0] >> 4 {
+	case 4:
+		if int(b[0]&15)*4 < 20 || int(b[0]&15)*4 > len(b) || int(binary.BigEndian.Uint16(b[2:4])) != len(b) {
+			return errors.New("TONO_PACKET_INVALID")
+		}
+		protocol = header.IPv4ProtocolNumber
+	case 6:
+		if len(b) < 40 || int(binary.BigEndian.Uint16(b[4:6]))+40 != len(b) {
+			return errors.New("TONO_PACKET_INVALID")
+		}
+		protocol = header.IPv6ProtocolNumber
+	default:
+		return errors.New("TONO_PACKET_INVALID")
+	}
+	p := stack.NewPacketBuffer(stack.PacketBufferOptions{Payload: buffer.MakeWithData(append([]byte(nil), b...))})
+	defer p.DecRef()
+	f.endpoint.InjectInbound(protocol, p)
+	return nil
+}
diff --git a/experimental/libbox/tono_packet_flow_test.go b/experimental/libbox/tono_packet_flow_test.go
new file mode 100644
index 000000000..6d167c372
--- /dev/null
+++ b/experimental/libbox/tono_packet_flow_test.go
@@ -0,0 +1,107 @@
+//go:build tono_mobile && with_gvisor
+
+package libbox
+
+import (
+	"encoding/binary"
+	"encoding/hex"
+	"net/netip"
+	"testing"
+	"time"
+
+	"github.com/sagernet/gvisor/pkg/tcpip"
+	"github.com/sagernet/gvisor/pkg/tcpip/checksum"
+	"github.com/sagernet/gvisor/pkg/tcpip/header"
+)
+
+func TestTonoPacketFlowDNSAndShutdown(t *testing.T) {
+	// Actual box -> tun factory -> gVisor -> DNS router -> packet flow, no FD.
+	const config = `{"log":{"disabled":true},"inbounds":[{"type":"tun","tag":"tun","address":["198.18.0.1/30","fdfe:dcba:9876::1/126"],"mtu":1280,"dns_mode":"disabled"}],"dns":{"servers":[{"type":"fakeip","tag":"fake","inet4_range":"198.19.0.0/16"},{"type":"udp","tag":"unused","server":"127.0.0.1"}],"rules":[{"query_type":"A","server":"fake"}],"final":"unused"},"outbounds":[{"type":"direct"}],"route":{"rules":[{"port":53,"action":"hijack-dns"},{"action":"reject"}]}}`
+	if err := CheckConfig(config); err != nil {
+		t.Fatal(err)
+	}
+	s, err := TonoStart(config)
+	if err != nil {
+		t.Fatal(err)
+	}
+	defer s.Close()
+	dns, _ := hex.DecodeString("471101000001000000000000076578616d706c6503636f6d0000010001")
+	p := make([]byte, 28+len(dns))
+	p[0] = 0x45
+	p[8] = 64
+	p[9] = 17
+	binary.BigEndian.PutUint16(p[2:4], uint16(len(p)))
+	copy(p[12:20], []byte{198, 18, 0, 1, 198, 18, 0, 2})
+	binary.BigEndian.PutUint16(p[10:12], ^checksum.Checksum(p[:20], 0))
+	binary.BigEndian.PutUint16(p[20:22], 49173)
+	binary.BigEndian.PutUint16(p[22:24], 53)
+	binary.BigEndian.PutUint16(p[24:26], uint16(8+len(dns)))
+	copy(p[28:], dns)
+	if err = s.Write(p); err != nil {
+		t.Fatal(err)
+	}
+	result := make(chan []byte, 1)
+	go func() { b, _ := s.Read(); result <- b }()
+	select {
+	case b := <-result:
+		if len(b) < 44 || b[0]>>4 != 4 || binary.BigEndian.Uint16(b[20:22]) != 53 || binary.BigEndian.Uint16(b[22:24]) != 49173 || b[28] != 0x47 || b[29] != 0x11 || b[30]&0x80 == 0 || binary.BigEndian.Uint16(b[34:36]) != 1 {
+			t.Fatalf("bad DNS response: %x", b)
+		}
+		if b[len(b)-4] != 198 || b[len(b)-3] != 19 {
+			t.Fatal("DNS did not return fake range")
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("DNS response timed out")
+	}
+	if s.Write([]byte{0x45}) == nil {
+		t.Fatal("accepted truncated packet")
+	}
+	v6 := make([]byte, 40)
+	v6[0] = 0x60
+	v6[5] = 1
+	if s.Write(v6) == nil {
+		t.Fatal("accepted invalid IPv6 payload length")
+	}
+	// Valid IPv6 UDP reaches the real stack's reject path, not the host network.
+	v6 = make([]byte, 49)
+	v6[0] = 0x60
+	v6[5] = 9
+	v6[6] = 17
+	v6[7] = 64
+	src := netip.MustParseAddr("fdfe:dcba:9876::1").As16()
+	dst := netip.MustParseAddr("2001:4860:4860::8888").As16()
+	copy(v6[8:24], src[:])
+	copy(v6[24:40], dst[:])
+	binary.BigEndian.PutUint16(v6[40:42], 49231)
+	binary.BigEndian.PutUint16(v6[42:44], 443)
+	binary.BigEndian.PutUint16(v6[44:46], 9)
+	v6[48] = 7
+	pseudo := header.PseudoHeaderChecksum(17, tcpip.AddrFrom16(src), tcpip.AddrFrom16(dst), 9)
+	binary.BigEndian.PutUint16(v6[46:48], ^checksum.Checksum(v6[40:], pseudo))
+	if err := s.Write(v6); err != nil {
+		t.Fatal(err)
+	}
+	go func() { b, _ := s.Read(); result <- b }()
+	select {
+	case b := <-result:
+		if len(b) < 48 || b[0]>>4 != 6 || b[6] != 58 || b[40] != 1 {
+			t.Fatalf("expected ICMPv6 unreachable: %x", b)
+		}
+	case <-time.After(5 * time.Second):
+		t.Fatal("IPv6 reject response timed out")
+	}
+	go func() { b, _ := s.Read(); result <- b }()
+	s.Close()
+	s.Close()
+	select {
+	case b := <-result:
+		if b != nil {
+			t.Fatal("read after close")
+		}
+	case <-time.After(time.Second):
+		t.Fatal("close failed to wake reader")
+	}
+	if s.Write(p) == nil {
+		t.Fatal("write after close")
+	}
+}
