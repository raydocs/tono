--- /dev/null
+++ b/common/tls/leaf_pin.go
@@ -0,0 +1,49 @@
+package tls
+
+import (
+	"crypto/sha256"
+	"crypto/subtle"
+	"crypto/tls"
+	"errors"
+	"time"
+
+	"github.com/sagernet/sing-box/option"
+)
+
+func validateLeafPin(o option.OutboundTLSOptions) error {
+	if len(o.CertificateLeafSHA256) == 0 {
+		return nil
+	}
+	if len(o.CertificateLeafSHA256) != sha256.Size || !o.Enabled || o.Insecure || o.DisableSNI ||
+		(o.Engine != "" && o.Engine != "go") || o.ServerName == "" ||
+		len(o.CertificatePublicKeySHA256) != 0 || len(o.Certificate) != 0 || o.CertificatePath != "" ||
+		(o.UTLS != nil && o.UTLS.Enabled) || (o.Reality != nil && o.Reality.Enabled) ||
+		(o.ECH != nil && o.ECH.Enabled) {
+		return errors.New("TONO_INVALID_LEAF_PIN_OPTIONS")
+	}
+	return nil
+}
+
+func leafPinVerifier(pin []byte, name string, clock func() time.Time) func(tls.ConnectionState) error {
+	return func(state tls.ConnectionState) error {
+		if len(state.PeerCertificates) == 0 {
+			return errors.New("TONO_MISSING_LEAF")
+		}
+		leaf := state.PeerCertificates[0]
+		hash := sha256.Sum256(leaf.Raw)
+		if subtle.ConstantTimeCompare(pin, hash[:]) != 1 {
+			return errors.New("TONO_LEAF_PIN_MISMATCH")
+		}
+		now := time.Now()
+		if clock != nil {
+			now = clock()
+		}
+		if now.Before(leaf.NotBefore) || now.After(leaf.NotAfter) {
+			return errors.New("TONO_LEAF_TIME_INVALID")
+		}
+		if leaf.VerifyHostname(name) != nil {
+			return errors.New("TONO_LEAF_NAME_INVALID")
+		}
+		return nil
+	}
+}
diff --git a/common/tls/leaf_pin_test.go b/common/tls/leaf_pin_test.go
new file mode 100644
index 000000000..7cb6b3d4b
--- /dev/null
+++ b/common/tls/leaf_pin_test.go
@@ -0,0 +1,96 @@
+package tls
+
+import (
+	"context"
+	"crypto/ecdsa"
+	"crypto/elliptic"
+	"crypto/rand"
+	"crypto/sha256"
+	stdtls "crypto/tls"
+	"crypto/x509"
+	"math/big"
+	"testing"
+	"time"
+
+	"github.com/sagernet/quic-go"
+	"github.com/sagernet/sing-box/option"
+)
+
+func TestExactLeafPinRejectsSameKeyReplacement(t *testing.T) {
+	key, _ := ecdsa.GenerateKey(elliptic.P256(), rand.Reader)
+	now := time.Now()
+	mint := func(serial int64) *x509.Certificate {
+		template := &x509.Certificate{SerialNumber: big.NewInt(serial), DNSNames: []string{"node.example"}, NotBefore: now.Add(-time.Hour), NotAfter: now.Add(time.Hour)}
+		der, err := x509.CreateCertificate(rand.Reader, template, template, &key.PublicKey, key)
+		if err != nil {
+			t.Fatal(err)
+		}
+		cert, err := x509.ParseCertificate(der)
+		if err != nil {
+			t.Fatal(err)
+		}
+		return cert
+	}
+	a, b := mint(1), mint(2)
+	pin := sha256.Sum256(a.Raw)
+	o := option.OutboundTLSOptions{Enabled: true, ServerName: "node.example", CertificateLeafSHA256: pin[:]}
+	c, err := NewSTDClient(context.Background(), nil, "", o)
+	if err != nil {
+		t.Fatal(err)
+	}
+	cfg, err := c.STDConfig()
+	if err != nil {
+		t.Fatal(err)
+	}
+	if !cfg.InsecureSkipVerify || cfg.VerifyConnection == nil {
+		t.Fatal("pin verifier not wired")
+	}
+	state := stdtls.ConnectionState{PeerCertificates: []*x509.Certificate{a}, DidResume: true}
+	if err = cfg.VerifyConnection(state); err != nil {
+		t.Fatal(err)
+	}
+	state.PeerCertificates[0] = b
+	if cfg.VerifyConnection(state) == nil {
+		t.Fatal("same key replacement accepted")
+	}
+	if leafPinVerifier(pin[:], "wrong.example", nil)(stdtls.ConnectionState{PeerCertificates: []*x509.Certificate{a}}) == nil {
+		t.Fatal("wrong hostname accepted")
+	}
+	if leafPinVerifier(pin[:], "node.example", func() time.Time { return now.Add(2 * time.Hour) })(stdtls.ConnectionState{PeerCertificates: []*x509.Certificate{a}}) == nil {
+		t.Fatal("expired leaf accepted")
+	}
+	// The actual QUIC implementation used by sing-quic/HY2 must invoke it.
+	handshake := func(leaf *x509.Certificate) error {
+		server, err := quic.ListenAddr("127.0.0.1:0", &stdtls.Config{Certificates: []stdtls.Certificate{{Certificate: [][]byte{leaf.Raw}, PrivateKey: key}}, NextProtos: []string{"h3"}}, nil)
+		if err != nil {
+			t.Fatal(err)
+		}
+		defer server.Close()
+		ctx, cancel := context.WithTimeout(context.Background(), 2*time.Second)
+		defer cancel()
+		go func() {
+			c, e := server.Accept(ctx)
+			if e == nil {
+				<-ctx.Done()
+				c.CloseWithError(0, "")
+			}
+		}()
+		clientConfig := cfg.Clone()
+		clientConfig.NextProtos = []string{"h3"}
+		conn, err := quic.DialAddr(ctx, server.Addr().String(), clientConfig, nil)
+		if conn != nil {
+			conn.CloseWithError(0, "")
+		}
+		return err
+	}
+	if err := handshake(a); err != nil {
+		t.Fatal("pinned QUIC handshake failed", err)
+	}
+	if handshake(b) == nil {
+		t.Fatal("QUIC accepted same-key wrong leaf")
+	}
+	o.Insecure = true
+	if _, err = NewSTDClient(context.Background(), nil, "", o); err == nil {
+		t.Fatal("insecure pin override accepted")
+	}
+}
