{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "01 / SIGN IN": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "01 / 邮箱登录"
          }
        }
      }
    },
    "02 / CHECK YOUR EMAIL": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "02 / 查收邮件"
          }
        }
      }
    },
    "A little closer.\nA world more open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "距离近一点。\n世界，开阔一点。"
          }
        }
      }
    },
    "Find the latest email from Tono, then return here and paste the six-digit code. Tono verifies it automatically.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 Tono 发来的最新邮件，回到这里粘贴六位验证码，我们会自动验证。"
          }
        }
      }
    },
    "One quiet space for your connection, your routes, and your peace of mind.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接、线路与每一次出发，都在这一处安静的空间里。"
          }
        }
      }
    },
    "Open your inbox": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开邮箱，查收验证码"
          }
        }
      }
    },
    "Sign in to Tono": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录 Tono"
          }
        }
      }
    },
    "Start with your email. We’ll send a sign-in code — no password to remember.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从你的邮箱开始。收取一封验证码邮件，无需记住密码。"
          }
        }
      }
    },
    "Use another email": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "换邮箱"
          }
        }
      }
    },
    "YOUR EVERYDAY CONNECTION": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接，从容一点"
          }
        }
      }
    },
    "Your connection stays in your hands.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的连接，始终由你掌握。"
          }
        }
      }
    },
    "%@ %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@"
          }
        }
      }
    },
    "%@ could not be reached, so Tono connected through %@ and made it the selected cloud server.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %1$@，Tono 已改用 %2$@ 并将其设为当前云端节点。"
          }
        }
      }
    },
