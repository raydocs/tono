{
  "name": "tono-windows",
  "version": "0.0.72",
  "license": "GPL-3.0-only",
  "scripts": {
    "prepare": "husky || true",
    "dev": "node scripts/dev.mjs dev",
    "dev:service": "node scripts/dev.mjs service",
    "dev:sidecar": "node scripts/dev.mjs sidecar",
    "dev:diff": "node scripts/dev.mjs dev",
    "dev:trace": "node scripts/dev.mjs trace",
    "dev:tauri": "cross-env RUST_BACKTRACE=full tauri dev -f tauri-dev",
    "build": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tauri build",
    "build:fast": "cross-env NODE_OPTIONS='--max-old-space-size=4096' tauri build -- --profile fast-release",
    "tauri": "tauri",
    "web:dev": "vite",
    "web:build": "tsc --noEmit && vite build",
    "web:serve": "vite preview",
    "prebuild": "node scripts/prebuild.mjs",
    "portable": "node scripts/portable.mjs",
    "portable-fixed-webview2": "node scripts/portable-fixed-webview2.mjs",
    "fix-alpha-version": "node scripts/fix-alpha_version.mjs",
    "release-version": "node scripts/release-version.mjs",
    "release:preflight": "node scripts/windows-release-preflight.mjs",
    "release:updater-config": "node scripts/prepare-updater-config.mjs",
    "release:autobuild": "pnpm release-version autobuild",
    "release:deploytest": "pnpm release-version deploytest",
    "publish-version": "node scripts/publish-version.mjs",
    "eslint": "pnpm lint",
    "lint": "eslint -c eslint.config.ts --max-warnings=0 --cache --cache-location .eslintcache src",
    "lint:fix": "eslint -c eslint.config.ts --max-warnings=0 --cache --cache-location .eslintcache --fix src",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "i18n:check": "node scripts/cleanup-unused-i18n.mjs",
    "i18n:format": "node scripts/cleanup-unused-i18n.mjs --align --apply",
    "i18n:types": "node scripts/generate-i18n-keys.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dev-control": "node --test scripts/pinned-core.test.mjs scripts/dev-control.test.mjs scripts/prepare-updater-config.test.mjs scripts/service-release.test.mjs scripts/validate-windows-channel.test.mjs scripts/windows-packaging.test.mjs",
    "knip:check": "knip",
    "knip:report": "knip --no-exit-code"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@juggle/resize-observer": "^3.4.0",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@tanstack/react-virtual": "^3.14.10",
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-clipboard-manager": "^2.3.3",
    "@tauri-apps/plugin-dialog": "^2.7.3",
    "@tauri-apps/plugin-fs": "^2.5.2",
    "@tauri-apps/plugin-http": "~2.6.0",
    "@tauri-apps/plugin-shell": "2.3.6",
    "@tauri-apps/plugin-updater": "2.11.0",
    "ahooks": "^3.10.0",
    "cidr-block": "^2.3.0",
    "dayjs": "1.11.23",
    "foxact": "^0.3.11",
    "foxts": "^5.9.1",
    "i18next": "^26.4.2",
    "js-yaml": "^5.4.1",
    "lodash-es": "^4.18.1",
    "meta-json-schema": "^1.19.30",
    "nanoid": "^6.0.1",
    "qrcode.react": "^4.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-error-boundary": "6.1.5",
    "react-hook-form": "^7.87.0",
    "react-i18next": "17.0.13",
    "react-markdown": "10.1.0",
    "react-router": "^8.3.1",
    "rehype-raw": "^7.0.0",
    "swr": "^2.5.1",
    "tono-plugin-core-api": "file:../crates/tono-plugin-core",
    "types-pac": "^1.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "@actions/github": "^9.1.1",
    "@biomejs/biome": "^2.5.12",
    "@eslint-react/eslint-plugin": "^5.18.10",
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "2.11.4",
    "@testing-library/react": "^16.3.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^26.4.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@types/validator": "^13.15.10",
    "@vitejs/plugin-legacy": "^8.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "adm-zip": "^0.6.0",
    "axios": "^1.20.0",
    "cli-color": "^2.0.4",
    "commander": "^15.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-es-x": "^10.0.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react-compiler": "19.1.0-rc.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "eslint-plugin-sukka": "^10.2.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "glob": "^13.0.6",
    "globals": "^17.12.0",
    "https-proxy-agent": "^9.1.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "knip": "6.34.0",
    "lint-staged": "^17.5.0",
    "sass": "^1.104.0",
    "tar": "^7.5.22",
    "terser": "^5.51.2",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-svgr": "^5.2.0",
    "vitest": "^5.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix --max-warnings=0",
      "biome format --write"
    ],
    "*.{css,scss,json}": [
      "biome format --write"
    ]
  },
  "type": "module",
  "packageManager": "pnpm@11.26.0"
}
