# Every five minutes. OnCalendar rather than OnUnitActiveSec: the exit-agent
# rollout saw OnUnitActiveSec timers stuck at "NEXT n/a" after a stop/start.
[Unit]
Description=Run the Tono API relay end-to-end probe every 5 minutes

[Timer]
OnCalendar=*:0/5
RandomizedDelaySec=30
Persistent=false

[Install]
WantedBy=timers.target
